# nvidia-nvsentinel-mcp. Run `make help` for targets.
SHELL := /bin/bash
VENV := .venv
BIN := $(VENV)/bin
PYTHON ?= python3
IMAGE ?= nvsentinel-mcp:local

.PHONY: help dev lint test lock image lab-up lab-install lab-fixture lab-token lab-down e2e e2e-image

help:
	@echo "  make dev          venv and dependencies (on the build machine: make dev PYTHON=/home/linuxbrew/.linuxbrew/opt/python@3.12/bin/python3.12)"
	@echo "  make lint         ruff"
	@echo "  make test         unit and protocol tests against a fake kubectl; no cluster"
	@echo "  make lock         regenerate requirements.txt, with hashes"
	@echo "  make image        build the image locally"
	@echo "  make lab-up       create the kind cluster"
	@echo "  make lab-install  install NVSentinel through omerfsen.aicr (AICR_DIR=<checkout>)"
	@echo "  make lab-fixture  simulated DCGM, labels, workload, the server's RBAC"
	@echo "  make lab-token    mint the server's short-lived kubeconfigs"
	@echo "  make e2e          run the scenarios through the MCP server on the lab"
	@echo "  make e2e-image    the same, with the server in its container (IMAGE=<ref>)"
	@echo "  make lab-down     delete the kind cluster"

$(BIN)/nvsentinel-mcp: pyproject.toml
	$(PYTHON) -m venv $(VENV)
	$(BIN)/pip install -q --disable-pip-version-check -e '.[dev]'
	touch $@

dev: $(BIN)/nvsentinel-mcp

lint: dev
	$(BIN)/ruff check .
	$(BIN)/ruff format --check .

test: dev
	$(BIN)/pytest

lock:
	docker run --rm -v "$$PWD:/w" -w /w python:3.13-slim-trixie@sha256:ae14d4ce8771606477a81446e7ef429edd6762305fc50c84507c1041fa8285d1 \
	  sh -c 'pip -q install --root-user-action=ignore --disable-pip-version-check pip-tools && pip-compile -q --generate-hashes --allow-unsafe --no-header --strip-extras --no-emit-index-url -o /tmp/r.txt pyproject.toml && (echo "# Generated by \`make lock\` from pyproject.toml, with hashes. The image installs only this."; cat /tmp/r.txt) > requirements.txt'

image:
	docker build -t $(IMAGE) .

lab-up:
	lab/up.sh

lab-install:
	lab/install-nvsentinel.sh

lab-fixture:
	lab/fixture.sh

lab-token:
	lab/mint-kubeconfig.sh

lab-down:
	lab/down.sh

e2e: dev
	$(BIN)/python tests/e2e/run.py

e2e-image: dev
	$(BIN)/python tests/e2e/run.py --image $(IMAGE)
