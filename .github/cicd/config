# .github/cicd/config - this repo's settings for the pipelines vendored from
# https://github.com/omerfsen/cicd. Plain KEY=value lines, read by the
# workflows from main (so a PR cannot change them for itself).

PIPELINES=release-please pr-title security

# release-please: off until the MCP server has passed on the lab; the release
# App is created then. VERSION_FILES hold the version it bumps.
VERSION_FILES=version.txt src/nvsentinel_mcp/__init__.py
RELEASE_PLEASE_ENABLED=false
RELEASE_PLEASE_RUNNER=ubuntu-24.04

PR_TITLE_ENABLED=true
PR_TITLE_RUNNER=ubuntu-24.04

# security: gitleaks, osv-scanner on requirements.txt and kubectl/go.sum, semgrep.
SECURITY_ENABLED=true
SECURITY_RUNNER=ubuntu-24.04
